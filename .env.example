# Copy to .env for local runs (never commit .env).

# --- Secrets ---
AHREFS_API_TOKEN=your-ahrefs-api-v3-token

# --- Configuration (optional) ---
# Hard cap on API units spent in one run
RADAR_UNIT_BUDGET=12000
# Skip the run entirely if the workspace has fewer units than this left
RADAR_MIN_REMAINING=60000
# CONFIG_DIR=./config
# DATA_DIR=./data
